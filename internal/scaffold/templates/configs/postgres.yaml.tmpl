# Postgres config — YAML (.yaml/.yml) and prototext (.textproto/.pbtxt) are equivalent.
# Schema: zengo/platform api/config/db/postgres/config.proto

kind: postgres
api_version: v1
spec:
  host: localhost
  port: 5432
  db_name: {{HANDLER_PKG}}s
  user_name: postgres
  password: postgres
  enable_metrics: true
